NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=sb-secret-service-role-key
AZURE_IOT_HUB_HOST=your-hub.azure-devices.net
AZURE_IOT_HUB_CONNECTION_STRING=HostName=your-hub.azure-devices.net;SharedAccessKeyName=iothubowner;SharedAccessKey=your-key

# Telemetry ingestion cron
IOT_HUB_EVENTHUB_CONNECTION=    # IoT Hub → Built-in endpoints → Event Hub-compatible endpoint
CRON_SECRET=                    # Any random string — used by Vercel to authenticate the cron call
